#include <Arduino.h>
#include <SPI.h>
#include <Preferences.h>

// =================== UART CONFIG ===================
//static const uint32_t CTRL_BAUD = 115200;  // Daisy RX=16, TX=17

// =================== MUX CONFIG ====================
// we'll KEEP these so the rest of your code still compiles
const int M1_S0 = 4, M1_S1 = 2, M1_S2 = 32, M1_S3 = 33, M1_EN = 21;
const int M2_S0 = 25, M2_S1 = 26, M2_S2 = 27, M2_S3 = 14, M2_EN = 22;
const int ADC_M1 = 36;  // ADC1_CH0
const int ADC_M2 = 39;  // ADC1_CH3

// =================== DIGIPOT CONFIG =================
const int PIN_SCK  = 18;
const int PIN_MISO = 19;
const int PIN_MOSI = 23;
const int PIN_CS1  = 5;
const int PIN_CS2  = 15;

const int N_MUX = 32;
const int N_DIG = 12;
uint16_t muxVals[N_MUX];
uint8_t  digiVals[N_DIG];

// which MUX inputs map to digipots and Daisy
uint8_t digiRoute[N_DIG] = {4,5,14,13,12,11,30,25,28,26,27,29};
uint8_t daisyRoute[8]   = {0,1,2,3,18,16,17,19};

// =================== UTILITIES ======================
inline void setAddr(int s0,int s1,int s2,int s3,int ch){
  digitalWrite(s0,(ch>>0)&1);
  digitalWrite(s1,(ch>>1)&1);
  digitalWrite(s2,(ch>>2)&1);
  digitalWrite(s3,(ch>>3)&1);
}

uint16_t readADC(int pin){
  int raw = analogRead(pin);             // 0–4095 (12-bit)
  return (uint16_t)((raw<<4)|(raw>>8));  // expand to 16-bit
}

// EN is still a parameter so calls don't change, but we do NOTHING with it
void scanMux16(int s0,int s1,int s2,int s3,int en,int adcPin,uint16_t* out16){
  digitalWrite(en, HIGH); 
  for(int ch = 0; ch < 16; ++ch){
    setAddr(s0,s1,s2,s3,ch);
    delayMicroseconds(20);
    (void)analogRead(adcPin);  // throwaway sample
    delayMicroseconds(20);
    out16[ch] = readADC(adcPin);
  }
}

// =================== DIGIPOT DRIVER =================
void ad5206Write(int cs,uint8_t channel,uint8_t value){
  digitalWrite(cs,LOW);
  SPI.transfer(channel & 0x0F);
  SPI.transfer(value);
  digitalWrite(cs,HIGH);
}

void setDigi(uint8_t index,uint8_t val){
  if(index >= N_DIG) return;
  uint8_t chip = index / 6;
  uint8_t chan = index % 6;
  int cs = (chip == 0) ? PIN_CS1 : PIN_CS2;
  if(digiVals[index] != val){
    digiVals[index] = val;
    ad5206Write(cs, chan, val);
  }
}

static inline uint8_t map16to8(uint16_t v){ return v >> 8; }


// =================== SETUP / LOOP ===================
void setup(){
  // UART to Daisy (TX=17, RX=16)
  Serial2.begin(76800, SERIAL_8N1, 3, 1);

  pinMode(M1_S0,OUTPUT); pinMode(M1_S1,OUTPUT);
  pinMode(M1_S2,OUTPUT); pinMode(M1_S3,OUTPUT);
  pinMode(M2_S0,OUTPUT); pinMode(M2_S1,OUTPUT);
  pinMode(M2_S2,OUTPUT); pinMode(M2_S3,OUTPUT);
  // we still declare EN pins, but we don't drive them
  pinMode(M1_EN,OUTPUT);
  pinMode(M2_EN,OUTPUT);
  digitalWrite(M1_EN,HIGH); 
  digitalWrite(M2_EN,HIGH); 

  analogReadResolution(12);

  // just in case you need that extra pin
  pinMode(12, OUTPUT); 
  digitalWrite(12, HIGH);

  SPI.begin(PIN_SCK, PIN_MISO, PIN_MOSI, PIN_CS1);
  pinMode(PIN_CS1,OUTPUT); 
  pinMode(PIN_CS2,OUTPUT);
  digitalWrite(PIN_CS1,HIGH); 
  digitalWrite(PIN_CS2,HIGH);

  // init digipots
  for(int ch = 0; ch < 6; ++ch){
    ad5206Write(PIN_CS1, ch, 128);
    ad5206Write(PIN_CS2, ch, 128);
    digiVals[ch]   = 128;
    digiVals[ch+6] = 128;
  }
}
uint8_t tx_bytes[18] = 
{
  0xAA,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x00,
  0x55
};

uint8_t rx_byte = 0x00;
uint16_t p[11];

void loop(){
  uint16_t m1[16], m2[16];
  scanMux16(M1_S0, M1_S1, M1_S2, M1_S3, M1_EN, ADC_M1, m1);
  scanMux16(M2_S0, M2_S1, M2_S2, M2_S3, M2_EN, ADC_M2, m2);

  for(int i = 0; i < 16; i++) muxVals[i]      = m1[i];
  for(int i = 0; i < 16; i++) muxVals[16 + i] = m2[i];

  // only runs if you actually fill digiRoute[]
  for(int i = 0; i < N_DIG; i++){
    // if digiRoute is empty, skip
    // (right now your array is empty so this will just read muxVals[0])
    uint8_t v8 = map16to8(muxVals[digiRoute[i]]);
    setDigi(i, v8);
  }

  if(Serial2.available() > 0)
  {
    rx_byte = Serial2.read();
    if(rx_byte == 0x69)
    {
      for(uint8_t i = 0; i < 8; i++)
        p[i] = muxVals[daisyRoute[i]];

      tx_bytes[0] = 0xAA; // Start marker
      for(uint8_t i = 1; i < 17; i++)
      {
        if((i % 2) == 1) // MSByte
          tx_bytes[i] = (uint8_t)((p[(i-1) >> 1] & 0xFF00) >> 8); // Copy top half of 16bit knob to first byte
        else // LSByte
          tx_bytes[i] = (uint8_t)(p[(i-1) >> 1] & 0x00FF); // Copy bottom half of 16bit knob to second byte
      }
      tx_bytes[17] = 0x55; // End marker
      Serial2.write(tx_bytes, 18);
    }
  }
  delayMicroseconds(100);
}
